# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/skillforge

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
# Comma-separated allowed origins, e.g. http://localhost:3000,https://your-app.vercel.app
CLIENT_URL=http://localhost:3000
# Base URL of this server, e.g. http://localhost:5000 or https://your-app.onrender.com
SERVER_URL=http://localhost:5000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret

# Email (optional - password reset) — Resend takes priority over SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
MAIL_FROM=SkillForge <no-reply@skillforge.dev>

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
